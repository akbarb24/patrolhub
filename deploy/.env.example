# Copy to .env (next to docker-compose.yml) and fill in.
DOMAIN=ronda.example.com
POSTGRES_PASSWORD=change-me-to-a-long-random-string

APP_ENV=production
HTTP_ADDR=:8080
BASE_URL=https://ronda.example.com
DATABASE_URL=postgres://patrolhub:change-me-to-a-long-random-string@db:5432/patrolhub?sslmode=disable
PHOTO_DIR=/data/photos
# Caddy is the only thing in front of the app, so its X-Forwarded-For can be trusted.
TRUST_PROXY=true
