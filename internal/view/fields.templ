package view

type Option struct {
	Value string
	Label string
}

templ selectField(label, name string, options []Option, selected, errMsg, placeholder string) {
	<div class="mb-5">
		<label class="mb-2 block px-2 text-sm font-semibold" for={ name }>{ label }</label>
		<select
			id={ name }
			name={ name }
			class={ "select w-full", templ.KV("select-error", errMsg != "") }
			if errMsg != "" {
				aria-invalid="true"
				aria-describedby={ name + "-error" }
			}
		>
			if placeholder != "" {
				<option value="">{ placeholder }</option>
			}
			for _, o := range options {
				<option value={ o.Value } selected?={ o.Value == selected }>{ o.Label }</option>
			}
		</select>
		if errMsg != "" {
			<p id={ name + "-error" } class="mt-2 px-2 text-sm font-semibold text-error">{ errMsg }</p>
		}
	</div>
}

templ textareaField(label, name, value, errMsg string) {
	<div class="mb-5">
		<label class="mb-2 block px-2 text-sm font-semibold" for={ name }>{ label }</label>
		<textarea
			id={ name }
			name={ name }
			rows="2"
			class={ "textarea w-full", templ.KV("textarea-error", errMsg != "") }
			if errMsg != "" {
				aria-invalid="true"
				aria-describedby={ name + "-error" }
			}
		>{ value }</textarea>
		if errMsg != "" {
			<p id={ name + "-error" } class="mt-2 px-2 text-sm font-semibold text-error">{ errMsg }</p>
		}
	</div>
}

// csrfField is the hidden token every plain form needs.
templ csrfField() {
	<input type="hidden" name="csrf_token" value={ Page(ctx).CSRFToken }/>
}

templ flashBlock(flash string) {
	if flash != "" {
		<div class="mb-5">
			@FlashMessage("success", flash)
		</div>
	}
}
