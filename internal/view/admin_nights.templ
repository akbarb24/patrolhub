package view

import (
	"fmt"

	"github.com/akbarbinaji/patrolhub/internal/domain"
	"github.com/akbarbinaji/patrolhub/internal/service"
)

templ NightsPage(cur, label, prev, next string, onlyReview bool, pending, rows []service.NightRow, flash string) {
	@AdminLayout("Malam") {
		@pageTitle("Admin", "Malam")
		@flashBlock(flash)
		if len(pending) > 0 {
			<section class="mb-10" aria-labelledby="pending-title">
				<h2 id="pending-title" class="mb-4 text-2xl font-semibold">Menunggu konfirmasi hujan</h2>
				<ul class="space-y-3">
					for _, n := range pending {
						<li class="flex flex-wrap items-center justify-between gap-2 oat p-5">
							<a class="text-lg font-semibold underline underline-offset-4" href={ templ.SafeURL("/admin/nights/" + n.Date.String()) }>{ domain.FormatDateID(n.Date) }</a>
							<div class="flex gap-2">
								<form method="post" action={ templ.SafeURL("/admin/nights/" + n.Date.String() + "/rain/confirm") }>
									@csrfField()
									<button type="submit" class="btn btn-primary btn-sm">Konfirmasi hujan</button>
								</form>
								<form method="post" action={ templ.SafeURL("/admin/nights/" + n.Date.String() + "/rain/reject") }>
									@csrfField()
									<button type="submit" class="btn btn-outline btn-sm">Tolak</button>
								</form>
							</div>
						</li>
					}
				</ul>
			</section>
		}
		<div class="mb-6 flex flex-wrap items-center gap-3">
			@monthPager(label, monthLink(prev, onlyReview), monthLink(next, onlyReview))
			<div class="flex flex-wrap gap-2 sm:ml-auto">
				@filterPill(reviewToggle(cur, onlyReview), "Hanya yang perlu ditinjau", onlyReview)
				<a class="btn btn-outline" href={ templ.SafeURL("/admin/export/" + cur[:4] + "/" + cur[5:] + ".csv") }>Ekspor CSV</a>
				<a class="btn btn-outline" href={ templ.SafeURL("/admin/export/" + cur[:4] + "/" + cur[5:] + ".xlsx") }>Ekspor Excel</a>
			</div>
		</div>
		<div class="sticker overflow-x-auto p-2">
			<table class="table">
				<thead>
					<tr>
						<th>Tanggal</th>
						<th>Status</th>
						<th>Hadir</th>
						<th>Foto</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, n := range rows {
						<tr>
							<td><a class="font-semibold underline underline-offset-4" href={ templ.SafeURL("/admin/nights/" + n.Date.String()) }>{ domain.FormatDateID(n.Date) }</a></td>
							<td>@StatusBadge(n.Status)</td>
							<td>{ fmt.Sprintf("%d/%d", n.Present, n.Total) }</td>
							<td>{ fmt.Sprint(n.Photos) }</td>
							<td>
								if n.NeedsReview {
									<span class="badge badge-warning border-ink">Perlu ditinjau</span>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
			if len(rows) == 0 {
				@EmptyState("Tidak ada malam.")
			}
		</div>
	}
}

func monthLink(month string, onlyReview bool) string {
	if onlyReview {
		return "/admin/nights?month=" + month + "&review=1"
	}
	return "/admin/nights?month=" + month
}

// reviewToggle links to the same month with the review filter flipped.
func reviewToggle(month string, onlyReview bool) string {
	if onlyReview {
		return "/admin/nights?month=" + month
	}
	return "/admin/nights?month=" + month + "&review=1"
}

templ NightDetailPage(d service.NightDetail, form Form, flash string) {
	@AdminLayout("Malam " + d.Date.String()) {
		<p class="mb-6"><a class="btn btn-outline btn-sm" href="/admin/nights">‹ Semua malam</a></p>
		<h1 class="mb-1">
			<span class="eyebrow block">Malam</span>
			<span class="display mt-2 block break-words text-5xl">{ domain.FormatDateID(d.Date) }</span>
		</h1>
		<p class="mb-8 mt-4 flex flex-wrap items-center gap-2">
			@StatusBadge(d.Status)
			if d.NeedsReview {
				<span class="badge badge-warning border-ink">Perlu ditinjau</span>
			}
		</p>
		@flashBlock(flash)
		if form.Errors["_"] != "" {
			<div class="mb-5">
				@FlashMessage("error", form.Errors["_"])
			</div>
		}
		<dl class="sticker mb-6 grid max-w-xl grid-cols-2 gap-x-4 gap-y-2 p-7">
			<dt class="text-base-content/70">Laporan pertama</dt>
			<dd>{ stampPtr(d.FirstReportedAt) }</dd>
			<dt class="text-base-content/70">Ditutup</dt>
			<dd>{ stampPtr(d.ClosedAt) }</dd>
			<dt class="text-base-content/70">Tarif denda</dt>
			<dd>
				if d.FineRate != nil {
					{ rupiah(*d.FineRate) }
				} else {
					–
				}
			</dd>
			<dt class="text-base-content/70">Total denda</dt>
			<dd>{ rupiah(d.TotalFine) }</dd>
			<dt class="text-base-content/70">Foto</dt>
			<dd>{ fmt.Sprintf("%d (minimal %d)", len(d.Photos), d.MinPhotos) }</dd>
		</dl>
		<div class="mb-10 flex flex-wrap gap-2">
			if d.Status == domain.NightRainRequested {
				<form method="post" action={ templ.SafeURL("/admin/nights/" + d.Date.String() + "/rain/confirm") }>
					@csrfField()
					<button type="submit" class="btn btn-primary btn-sm">Konfirmasi hujan</button>
				</form>
				<form method="post" action={ templ.SafeURL("/admin/nights/" + d.Date.String() + "/rain/reject") }>
					@csrfField()
					<button type="submit" class="btn btn-outline btn-sm">Tolak hujan</button>
				</form>
			}
			if d.Status != domain.NightRainedOut {
				<form method="post" action={ templ.SafeURL("/admin/nights/" + d.Date.String() + "/rain") }>
					@csrfField()
					<button type="submit" class="btn btn-outline btn-sm" onclick="return confirm('Tandai malam ini sebagai hujan? Semua denda malam ini dihapus.')">Tandai hujan</button>
				</form>
			}
		</div>

		<h2 class="mb-4 text-2xl font-semibold">Anggota</h2>
		<div class="sticker mb-10 overflow-x-auto p-2">
			<table class="table">
				<thead>
					<tr>
						<th>Nama</th>
						<th>Status</th>
						<th>Denda</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, m := range d.Members {
						<tr>
							<td>
								{ m.DisplayName }
								if m.Source != domain.SourceScheduled {
									<span class="badge badge-warning badge-sm ml-1">{ sourceLabel(m.Source) }</span>
								}
							</td>
							<td>
								<span class="inline-flex items-center gap-2">
									@StatusDot(m.Status, m.DisplayName+": "+attendanceLabel(m.Status))
									{ attendanceLabel(m.Status) }
								</span>
							</td>
							<td>{ rupiah(m.Fine) }</td>
							<td class="min-w-56">
								if d.ClosedAt != nil && d.Status != domain.NightRainedOut {
									<details open?={ form.Values["member_id"] == itoa(m.MemberID) }>
										<summary class="btn btn-outline btn-xs">Koreksi</summary>
										<form method="post" action={ templ.SafeURL("/admin/nights/" + d.Date.String() + "/attendance/" + itoa(m.MemberID)) } class="mt-2 space-y-2" novalidate>
											@csrfField()
											<select name="status" class="select select-sm w-full" aria-label="Status baru">
												<option value="PRESENT" selected?={ m.Status == domain.Present }>Hadir</option>
												<option value="ABSENT" selected?={ m.Status != domain.Present }>Tidak hadir</option>
											</select>
											if form.Values["member_id"] == itoa(m.MemberID) && form.Errors["status"] != "" {
												<p class="text-xs text-error">{ form.Errors["status"] }</p>
											}
											<input name="reason" type="text" placeholder="Alasan (wajib)" aria-label="Alasan koreksi" class="input input-sm w-full" value={ reasonValue(form, m.MemberID) }/>
											if form.Values["member_id"] == itoa(m.MemberID) && form.Errors["reason"] != "" {
												<p class="text-xs text-error">{ form.Errors["reason"] }</p>
											}
											<button type="submit" class="btn btn-neutral btn-sm">Simpan koreksi</button>
										</form>
									</details>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
			if len(d.Members) == 0 {
				@EmptyState("Tidak ada anggota pada malam ini.")
			}
		</div>

		<h2 class="mb-4 text-2xl font-semibold">Situasi</h2>
		<p class="sticker mb-10 whitespace-pre-line p-7">
			if d.Situation == "" {
				<span class="text-base-content/70">Tidak ada catatan.</span>
			} else {
				{ d.Situation }
			}
		</p>

		<h2 class="mb-4 text-2xl font-semibold">Foto</h2>
		if len(d.Photos) == 0 {
			<p class="mb-6 text-base-content/70">Belum ada foto.</p>
		}
		<ul class="mb-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
			for _, p := range d.Photos {
				<li class="sticker p-2">
					<a href={ templ.SafeURL("/admin/photos/" + itoa(p.ID)) } target="_blank" rel="noopener">
						<img src={ "/admin/photos/" + itoa(p.ID) } alt={ "Foto ronda pukul " + ClockText(p.TakenAt) } loading="lazy" class="aspect-square w-full rounded-2xl object-cover"/>
					</a>
					<p class="mt-2 px-2 pb-1 text-sm">
						{ ShortStamp(p.TakenAt) }
						if mapsURL(p.Latitude, p.Longitude) != "" {
							· <a class="underline" href={ templ.SafeURL(mapsURL(p.Latitude, p.Longitude)) } target="_blank" rel="noopener">Peta</a>
						}
					</p>
				</li>
			}
		</ul>

		<h2 class="mb-4 text-2xl font-semibold">Riwayat</h2>
		if len(d.Audit) == 0 {
			<p class="text-base-content/70">Belum ada riwayat.</p>
		}
		<ol class="space-y-2 text-sm">
			for _, a := range d.Audit {
				<li class="rounded-2xl bg-base-100 px-4 py-3">
					<span class="text-base-content/70">{ ShortStamp(a.At) }</span>
					· <strong>{ auditLabel(a.Action) }</strong>
					· { a.Actor }
					if a.IP != "" {
						· { a.IP }
					}
					if a.Reason != "" {
						<span class="block">Alasan: { a.Reason }</span>
					}
					if a.Detail != "" {
						<code class="block break-all text-xs text-base-content/70">{ a.Detail }</code>
					}
				</li>
			}
		</ol>
	}
}

func sourceLabel(s domain.AttendanceSource) string {
	if s == domain.SourceWalkIn {
		return "pengganti"
	}
	return "perubahan jadwal"
}

func reasonValue(form Form, memberID int64) string {
	if form.Values["member_id"] == itoa(memberID) {
		return form.Values["reason"]
	}
	return ""
}
