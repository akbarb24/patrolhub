package view

import (
	"fmt"

	"github.com/akbarbinaji/patrolhub/internal/domain"
	"github.com/akbarbinaji/patrolhub/internal/service"
)

// RecapNav carries what the shared recap header needs.
type RecapNav struct {
	Title     string // "September 2026"
	Prev      string // href of the previous month
	Next      string // href of the next month; empty when already on the current month
	Summary   string // href of the Ringkasan tab
	Situation string // href of the Situasi tab
	TextBase  string // base URL of the copy-text endpoint, e.g. /recap/2026/09/text
}

templ recapHeader(nav RecapNav, active string) {
	<div class="mb-6 flex items-end justify-between gap-3">
		<h1 class="min-w-0">
			<span class="eyebrow block">Rekap Ronda</span>
			<span class="display mt-2 block break-words text-5xl">{ nav.Title }</span>
		</h1>
		<div class="flex shrink-0 gap-2 pb-1">
			<a class="btn btn-circle btn-outline" href={ templ.SafeURL(nav.Prev) } aria-label="Bulan sebelumnya">‹</a>
			if nav.Next != "" {
				<a class="btn btn-circle btn-outline" href={ templ.SafeURL(nav.Next) } aria-label="Bulan berikutnya">›</a>
			} else {
				<span class="btn btn-circle btn-outline btn-disabled" aria-disabled="true" aria-label="Bulan berikutnya belum tersedia">›</span>
			}
		</div>
	</div>
	<nav class="tabs tabs-box mb-6 grid grid-cols-2" aria-label="Rekap">
		<a
			href={ templ.SafeURL(nav.Summary) }
			class={ "tab", templ.KV("tab-active", active == "summary") }
			if active == "summary" {
				aria-current="page"
			}
		>Ringkasan</a>
		<a
			href={ templ.SafeURL(nav.Situation) }
			class={ "tab", templ.KV("tab-active", active == "situations") }
			if active == "situations" {
				aria-current="page"
			}
		>Situasi</a>
	</nav>
}

templ RecapSummaryPage(r service.Recap, nav RecapNav) {
	@PublicLayout("Rekap Ronda " + nav.Title) {
		@recapHeader(nav, "summary")
		if r.Summary.NightsTotal == 0 {
			@EmptyState("Belum ada data untuk bulan ini.")
		} else {
			<section class="grid grid-cols-2 gap-4" aria-label="Ringkasan bulan">
				@statCard("Malam terlapor", fmt.Sprintf("%d/%d", r.Summary.Reported, r.Summary.NightsTotal), fmt.Sprintf("%d hujan · %d tanpa laporan", r.Summary.Rain, r.Summary.NoReport))
				@statCard("Kehadiran", fmt.Sprintf("%d%%", r.Summary.RatePercent), fmt.Sprintf("%d dari %d jadwal", r.Summary.PresentCount, r.Summary.SlotCount))
				<div class="oat col-span-2 p-6">
					<p class="text-sm text-base-content/70">Total denda { domain.MonthNameID(r.Month) }</p>
					<p class="mt-1 text-3xl font-semibold leading-tight">{ domain.FormatRupiah(r.Summary.TotalFine) }</p>
					<p class="mt-1 text-sm text-base-content/70">{ fmt.Sprintf("%d peserta kena denda · %s / tidak hadir", r.Summary.FinedMembers, domain.FormatRupiah(r.FineRate)) }</p>
				</div>
			</section>
			if nav.TextBase != "" {
			<div class="mt-4 flex items-center justify-end gap-3">
				<p id="copy-status" role="status" class="hidden text-sm font-semibold">Rekap disalin</p>
				<details id="copy-menu" class="dropdown dropdown-end">
					<summary class="btn btn-neutral">Salin rekap</summary>
					<ul class="menu dropdown-content sticker z-10 mt-2 w-56 p-2">
						<li><button type="button" data-copy="month" data-base={ nav.TextBase }>Bulan ini</button></li>
						<li><button type="button" data-copy="week" data-base={ nav.TextBase }>7 malam terakhir</button></li>
					</ul>
				</details>
			</div>
			<script src="/static/js/recap.js" defer></script>
			}
			<ul class="mt-6 flex flex-wrap gap-2 text-sm" aria-label="Legenda">
				<li class="inline-flex items-center gap-2 rounded-full bg-base-100 py-1 pl-1 pr-4">@StatusDot(domain.Present, "Hadir") Hadir</li>
				<li class="inline-flex items-center gap-2 rounded-full bg-base-100 py-1 pl-1 pr-4">@StatusDot(domain.Absent, "Tidak hadir") Tidak hadir</li>
				<li class="inline-flex items-center gap-2 rounded-full bg-base-100 py-1 pl-1 pr-4">@StatusDot(domain.RainedOut, "Hujan") Hujan</li>
			</ul>
			<div class="mt-6 space-y-5">
				for _, c := range r.Cards {
					@dayCard(c)
				}
			</div>
		}
	}
}

templ dayCard(c domain.DayCard) {
	<section class="sticker p-5" aria-labelledby={ fmt.Sprintf("card-%d", c.Weekday) }>
		<div class="flex items-center justify-between gap-2">
			<h2 id={ fmt.Sprintf("card-%d", c.Weekday) } class="text-xl font-semibold">{ c.Label }</h2>
			<span class="badge badge-warning">{ fmt.Sprintf("%d malam jaga", len(c.Dates)) }</span>
		</div>
		if len(c.Dates) == 0 {
			<p class="py-4 text-sm text-base-content/70">Belum ada malam jaga bulan ini.</p>
		} else {
			<div class="mt-3 text-sm">
				<div class="grid items-center gap-x-1 border-b-2 border-ink pb-2 text-xs font-semibold text-base-content/70" style={ gridStyle(len(c.Dates)) }>
					<span></span>
					for _, d := range c.Dates {
						<span class="text-center">{ fmt.Sprint(d.Day) }</span>
					}
					<span class="text-right">Denda</span>
				</div>
				for _, row := range c.Rows {
					<div class="grid items-center gap-x-1 border-b border-fog py-2" style={ gridStyle(len(c.Dates)) }>
						<span class="truncate">{ row.DisplayName }</span>
						for i, cell := range row.Cells {
							<span class="flex justify-center">@StatusDot(cell, dotLabel(c.Dates[i], cell))</span>
						}
						<span class="text-right text-xs">{ fineCell(row.Fine) }</span>
					</div>
				}
				<div class="flex justify-between pt-3 font-semibold">
					<span>Subtotal tim</span>
					<span>{ domain.FormatRupiah(c.Subtotal) }</span>
				</div>
			</div>
		}
	</section>
}

templ RecapSituationsPage(r service.Recap, nav RecapNav, onlySpecial bool) {
	@PublicLayout("Rekap Ronda " + nav.Title) {
		@recapHeader(nav, "situations")
		<div class="flex flex-wrap gap-2">
			@filterPill(nav.Situation, "Semua malam", !onlySpecial)
			@filterPill(nav.Situation+"?special=1", "Ada catatan khusus", onlySpecial)
		</div>
		if len(r.Timeline) == 0 {
			@EmptyState("Belum ada data untuk bulan ini.")
		}
		<ol class="mt-6 space-y-4">
			for _, it := range r.Timeline {
				if !onlySpecial || it.Special {
					<li class="sticker flex gap-4 p-5">
						<div class="flex h-14 w-14 shrink-0 flex-col items-center justify-center rounded-2xl bg-oat">
							<p class="text-2xl font-semibold leading-none">{ fmt.Sprint(it.Date.Day) }</p>
							<p class="text-xs font-semibold text-base-content/70">{ weekdayShort(it.Weekday) }</p>
						</div>
						<div class="min-w-0 flex-1">
							<p class="flex flex-wrap items-center gap-1">
								switch it.Status {
									case domain.NightRainedOut:
										<span class="badge badge-outline">Hujan</span>
									case domain.NightNoReport:
										<span class="badge badge-neutral">Tanpa laporan</span>
									case domain.NightRainRequested:
										<span class="badge badge-warning border-ink">Menunggu konfirmasi hujan</span>
									default:
										<span class="badge badge-primary">{ fmt.Sprintf("%d/%d hadir", it.Present, it.Total) }</span>
								}
								if it.Special {
									<span class="badge badge-warning">Catatan khusus</span>
								}
							</p>
							if it.Note != "" {
								<p class="mt-2 whitespace-pre-line break-words">{ it.Note }</p>
							}
						</div>
					</li>
				}
			}
		</ol>
	}
}

// filterPill is a tag-style link; the active one gets the ink outline.
templ filterPill(href, label string, active bool) {
	<a
		href={ templ.SafeURL(href) }
		class={ "inline-flex min-h-10 items-center rounded-full border-2 bg-base-100 px-5 font-semibold", templ.KV("border-ink", active), templ.KV("border-transparent", !active) }
		if active {
			aria-current="page"
		}
	>{ label }</a>
}
