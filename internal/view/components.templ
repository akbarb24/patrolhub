package view

import "github.com/akbarbinaji/patrolhub/internal/domain"

// StatusDot is the attendance marker. Meaning never relies on colour alone:
// each status has its own icon and an aria-label such as "7 September: hadir".
templ StatusDot(status domain.AttendanceStatus, label string) {
	switch status {
		case domain.Present:
			<span role="img" aria-label={ label } class="inline-flex h-7 w-7 items-center justify-center rounded-full border-2 border-black bg-kofi text-ink">
				<svg viewBox="0 0 20 20" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10l4 4 8-8"></path></svg>
			</span>
		case domain.Absent:
			<span role="img" aria-label={ label } class="inline-flex h-7 w-7 items-center justify-center rounded-full border-2 border-black bg-ink text-white">
				<svg viewBox="0 0 20 20" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15"></path></svg>
			</span>
		case domain.RainedOut:
			<span role="img" aria-label={ label } class="inline-flex h-7 w-7 items-center justify-center rounded-full border-2 border-dashed border-ink/60 bg-oat text-ink">
				<svg viewBox="0 0 20 20" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M7 4l-2 4M12 4l-2 4M16 4l-2 4M8 12l-2 4M13 12l-2 4"></path></svg>
			</span>
		default:
			<span class="inline-block h-7 w-7" aria-hidden="true"></span>
	}
}

templ StatusBadge(status domain.NightStatus) {
	<span class={ "badge", nightStatusClass(status) }>{ nightStatusLabel(status) }</span>
}

// FlashMessage kind is one of "success", "error", "warning", "info".
templ FlashMessage(kind, text string) {
	<div role="alert" class={ "alert", flashClass(kind) }>
		<span>{ text }</span>
	</div>
}

templ EmptyState(text string) {
	<p class="py-10 text-center text-base-content/70">{ text }</p>
}

// monthPager is the ‹ Month › control shared by recap and admin month views.
// next may be empty when there is no later month to show.
templ monthPager(label, prev, next string) {
	<div class="flex items-center gap-2">
		<a class="btn btn-circle btn-outline btn-sm" href={ templ.SafeURL(prev) } aria-label="Bulan sebelumnya">‹</a>
		<span class="min-w-32 text-center text-xl font-semibold">{ label }</span>
		if next != "" {
			<a class="btn btn-circle btn-outline btn-sm" href={ templ.SafeURL(next) } aria-label="Bulan berikutnya">›</a>
		} else {
			<span class="btn btn-circle btn-outline btn-sm btn-disabled" aria-disabled="true" aria-label="Bulan berikutnya belum tersedia">›</span>
		}
	</div>
}

// statCard is one figure in a summary row.
templ statCard(label, value, note string) {
	<div class="sticker p-5">
		<p class="text-sm text-base-content/70">{ label }</p>
		<p class="mt-1 text-3xl font-semibold leading-tight">{ value }</p>
		if note != "" {
			<p class="mt-1 text-sm text-base-content/70">{ note }</p>
		}
	</div>
}
