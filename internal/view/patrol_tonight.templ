package view

import (
	"fmt"

	"github.com/akbarbinaji/patrolhub/internal/domain"
	"github.com/akbarbinaji/patrolhub/internal/service"
)

templ TonightPage(v service.TonightView) {
	@PublicLayout("Laporan Ronda " + v.RTName) {
		<h1 class="mb-3">
			<span class="eyebrow block">Laporan Ronda</span>
			<span class="display mt-2 block break-words text-5xl">{ v.RTName }</span>
		</h1>
		<p class="mb-8 inline-flex items-center gap-2 rounded-full bg-oat px-4 py-2 text-sm font-semibold">
			<svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4" width="14" height="13" rx="3"></rect><path d="M3 8h14M7 2v4M13 2v4"></path></svg>
			Tanggal: { domain.FormatDateID(v.NightDate) }
		</p>
		if v.Open && !v.Locked {
			@tonightOpen(v)
		} else if v.Summary() {
			@tonightSummary(v)
		} else {
			// The page behind the lock modal stays visible but cannot be reached.
			<div inert class="pointer-events-none select-none blur-[2px]">
				@card("Tim Ronda", "team-title") {
					if !v.Open {
						@upcomingTeam(v)
					} else {
						@readOnlyTeam(v)
					}
				}
			</div>
			@lockModal(v)
		}
	}
}

templ upcomingTeam(v service.TonightView) {
	if len(v.Team) == 0 {
		@EmptyState("Belum ada tim untuk malam ini.")
	}
	<ul class="divide-y divide-fog">
		for _, r := range v.Team {
			<li class="py-3">{ r.DisplayName }</li>
		}
	</ul>
}

// lockModal covers the report page while it cannot be filled in. It has no close
// button: the page reloads itself when the window opens (lock.js).
templ lockModal(v service.TonightView) {
	<div id="lock-modal" class="fixed inset-0 z-20 flex items-center justify-center bg-ink/60 p-4" role="dialog" aria-modal="true" aria-labelledby="lock-title" aria-describedby="lock-desc">
		<div class="sticker w-full max-w-[400px] p-7 text-center">
			if v.Locked {
				<p class="eyebrow">Laporan ditutup</p>
				<h2 id="lock-title" class="mt-2 text-xl font-semibold leading-snug">Laporan malam ini sudah ditutup.</h2>
				<p id="lock-desc" class="mt-1 text-base-content/70">Laporan berikutnya dibuka pukul { clockDotted(v.WindowOpen) }.</p>
			} else {
				<p class="eyebrow">Belum jam ronda</p>
				<h2 id="lock-title" class="mt-2 text-xl font-semibold leading-snug">Laporan dibuka pukul { clockDotted(v.WindowOpen) }</h2>
				<p id="lock-desc" class="mt-1 text-base-content/70">Kembali ke halaman ini saat jam ronda untuk mengisi kehadiran.</p>
			}
			<div class="oat mt-6 px-4 py-5">
				<p class="text-sm font-semibold">Dibuka dalam</p>
				<p class="display mt-1 text-5xl tabular-nums" role="timer" data-countdown={ itoa(int64(v.UntilOpen.Seconds())) }>{ countdown(v.UntilOpen) }</p>
			</div>
			<p class="mt-4 text-sm text-base-content/70">Halaman ini terbuka otomatis saat jam ronda dimulai.</p>
		</div>
	</div>
	<script src="/static/js/lock.js" defer></script>
}

// tonightOpen is the report form. Nothing but photos is saved until "Kirim Laporan";
// patrol.js keeps a draft in the browser so a reload does not lose the ticks and note.
templ tonightOpen(v service.TonightView) {
	<div id="toast" role="status" aria-live="polite" class="fixed inset-x-4 bottom-4 z-10 mx-auto hidden max-w-[448px] rounded-2xl border-2 border-black bg-error px-5 py-3 font-semibold text-error-content"></div>
	<div hidden data-reload-in={ itoa(int64(v.UntilClose.Seconds())) }></div>
	<form
		id="report-form"
		data-night={ v.NightDate.String() }
		data-min-photos={ itoa(int64(v.MinPhotos)) }
		hx-post="/patrol/tonight/submit"
		hx-swap="none"
		hx-confirm="Kirim laporan? Setelah dikirim, laporan tidak bisa diubah lagi."
		hx-disabled-elt="#submit-button"
	>
		@card("Tim Ronda", "team-title") {
			<p class="-mt-2 mb-2 text-sm text-base-content/70">Centang anggota yang hadir.</p>
			@teamForm(v)
		}
		@card("Situasi", "situation-title") {
			<textarea
				id="situation"
				name="note"
				maxlength="1000"
				rows="4"
				class="textarea w-full"
				placeholder="Mis. Aman"
				aria-label="Situasi malam ini"
				required
			>{ v.Situation }</textarea>
		}
	</form>
	@card("Foto", "photo-title") {
		@PhotoPanel(v)
		<input id="photo-input" type="file" accept="image/*" capture="environment" hidden/>
		<button id="photo-button" type="button" class="btn btn-outline btn-lg mt-5 w-full" onclick="document.getElementById('photo-input').click()">
			<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4z"></path><circle cx="12" cy="13" r="3.5"></circle></svg>
			Ambil Foto
		</button>
	}
	<section class="mb-6" aria-labelledby="submit-title">
		<h2 id="submit-title" class="sr-only">Kirim laporan</h2>
		<ul id="submit-checks" class="mb-3 space-y-1 px-2 text-sm">
			<li data-check="photos">Minimal { itoa(int64(v.MinPhotos)) } foto</li>
			<li data-check="note">Catatan situasi terisi</li>
		</ul>
		<button id="submit-button" type="submit" form="report-form" class="btn btn-primary btn-lg w-full">Kirim Laporan</button>
		<p class="mt-2 px-2 text-sm text-base-content/70">Setelah dikirim, laporan tidak bisa diubah lagi.</p>
	</section>
	<section class="mt-10" id="rain-box">
		@RainPanel(v)
	</section>
	<script src="/static/js/patrol.js" defer></script>
	<script src="/static/js/photo.js" defer></script>
}

// teamForm is the team as checkboxes plus the walk-in picker; walk-ins are added in
// the browser (patrol.js) and sent with the report as walk_in fields.
templ teamForm(v service.TonightView) {
	if len(v.Team) == 0 {
		<p id="team-empty" class="py-10 text-center text-base-content/70">Belum ada tim untuk malam ini.</p>
	}
	<ul id="team-list" class="divide-y divide-fog">
		for _, r := range v.Team {
			<li>
				<label class="flex min-h-14 cursor-pointer items-center justify-between gap-3 py-2">
					<span>
						{ r.DisplayName }
						if r.Source == domain.SourceWalkIn {
							<span class="badge badge-warning badge-sm ml-1">pengganti</span>
						}
					</span>
					<input
						type="checkbox"
						name="present"
						value={ itoa(r.MemberID) }
						class="checkbox checkbox-lg checkbox-primary"
						checked?={ r.Present }
						aria-label={ "Hadir: " + r.DisplayName }
					/>
				</label>
			</li>
		}
	</ul>
	if len(v.Candidates) > 0 {
		<button id="walk-in-open" type="button" class="btn btn-outline mt-4 w-full">+ Tambah anggota pengganti</button>
		<div id="walk-in-picker" class="mt-4 flex gap-2" hidden>
			<select id="walk-in-select" class="select min-w-0 flex-1" aria-label="Anggota pengganti">
				<option value="">Pilih anggota</option>
				for _, c := range v.Candidates {
					<option value={ itoa(c.ID) }>{ c.Label }</option>
				}
			</select>
			<button id="walk-in-add" type="button" class="btn btn-neutral">Tambah</button>
		</div>
	}
}

// tonightSummary is the read-only page after the report was sent (or rain was
// requested) while the night is still open.
templ tonightSummary(v service.TonightView) {
	<div hidden data-reload-in={ itoa(int64(v.UntilClose.Seconds())) }></div>
	<section class="oat mb-6 p-6" role="status">
		if v.Submitted {
			<p class="eyebrow">Laporan terkirim</p>
			<h2 class="mt-2 text-xl font-semibold leading-snug">Laporan sudah dikirim pukul { ClockText(v.SubmittedAt) }.</h2>
		} else {
			<p class="eyebrow">Hujan diajukan</p>
			<h2 class="mt-2 text-xl font-semibold leading-snug">Hujan diajukan, menunggu konfirmasi pengurus.</h2>
		}
		<p class="mt-1 text-base-content/70">Laporan malam ini tidak bisa diubah lagi.</p>
	</section>
	@card("Tim Ronda", "team-title") {
		@readOnlyTeam(v)
	}
	@card("Situasi", "situation-title") {
		if v.Situation == "" {
			<p class="text-base-content/70">Tidak ada catatan.</p>
		} else {
			<p class="whitespace-pre-line break-words">{ v.Situation }</p>
		}
	}
	@card("Foto", "photo-title") {
		@PhotoPanel(v)
	}
	<script src="/static/js/patrol.js" defer></script>
}

// readOnlyTeam lists the team with its attendance, without controls.
templ readOnlyTeam(v service.TonightView) {
	if len(v.Team) == 0 {
		@EmptyState("Belum ada tim untuk malam ini.")
	}
	<ul class="divide-y divide-fog">
		for _, r := range v.Team {
			<li class="flex min-h-14 items-center justify-between gap-3 py-2">
				<span>
					{ r.DisplayName }
					if r.Source == domain.SourceWalkIn {
						<span class="badge badge-warning badge-sm ml-1">pengganti</span>
					}
				</span>
				if r.Present {
					<span class="badge badge-primary">Hadir</span>
				} else {
					<span class="badge badge-neutral">Tidak hadir</span>
				}
			</li>
		}
	</ul>
}

templ PhotoPanel(v service.TonightView) {
	<div id="photo-list" data-count={ itoa(int64(len(v.Photos))) }>
		<p id="photo-count" class={ "text-sm", templ.KV("font-semibold", len(v.Photos) < v.MinPhotos) }>
			{ fmt.Sprint(len(v.Photos)) } dari minimal { fmt.Sprint(v.MinPhotos) } foto (maks. { fmt.Sprint(v.MaxPhotos) })
		</p>
		<ul class="mt-3 grid grid-cols-3 gap-3">
			for _, p := range v.Photos {
				<li>
					<img
						src={ "/patrol/tonight/photos/" + itoa(p.ID) + "/thumb" }
						alt={ "Foto ronda pukul " + ClockText(p.TakenAt) }
						class="aspect-square w-full rounded-2xl border-2 border-black object-cover"
						loading="lazy"
					/>
				</li>
			}
		</ul>
	</div>
}

// RainPanel asks the admins to confirm a rained-out night. It locks the report, so
// the handler reloads the page into the summary.
templ RainPanel(v service.TonightView) {
	<button
		type="button"
		class="btn btn-outline w-full"
		hx-post="/patrol/tonight/rain"
		hx-confirm="Ajukan malam ini sebagai hujan? Pengurus akan mengonfirmasi, dan laporan tidak bisa diubah lagi."
		hx-swap="none"
	>Laporkan Hujan</button>
}

// card is a sticker-outlined section with a heading.
templ card(title, id string) {
	<section class="sticker mb-6 p-6" aria-labelledby={ id }>
		<h2 id={ id } class="mb-4 text-xl font-semibold">{ title }</h2>
		{ children... }
	</section>
}
