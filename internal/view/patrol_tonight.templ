package view

import (
	"fmt"

	"github.com/akbarbinaji/patrolhub/internal/domain"
	"github.com/akbarbinaji/patrolhub/internal/service"
)

templ TonightPage(v service.TonightView) {
	@PublicLayout("Laporan Ronda " + v.RTName) {
		<h1 class="text-xl font-semibold">Laporan Ronda { v.RTName }</h1>
		<p class="mb-4 text-sm text-base-content/70">Tanggal: { domain.FormatDateID(v.NightDate) }</p>
		switch {
			case !v.Open:
				@tonightClosed(v)
			case v.Locked:
				@FlashMessage("info", "Laporan malam ini sudah ditutup.")
				<div class="mt-4">
					@TeamSection(v)
				</div>
			default:
				@tonightOpen(v)
		}
	}
}

templ tonightClosed(v service.TonightView) {
	@FlashMessage("info", "Laporan dibuka pukul "+clockDotted(v.WindowOpen))
	<h2 class="mb-2 mt-4 font-semibold">Tim Ronda</h2>
	if len(v.Team) == 0 {
		@EmptyState("Belum ada tim untuk malam ini.")
	}
	<ul class="divide-y divide-base-300 rounded-box bg-base-100 shadow-sm">
		for _, r := range v.Team {
			<li class="px-3 py-3">{ r.DisplayName }</li>
		}
	</ul>
}

templ tonightOpen(v service.TonightView) {
	<div id="toast" role="status" aria-live="polite" class="fixed inset-x-4 bottom-4 z-10 mx-auto hidden max-w-[448px] rounded-box bg-error px-4 py-3 text-sm text-error-content shadow-lg"></div>
	<section aria-labelledby="team-title">
		<h2 id="team-title" class="mb-2 font-semibold">Tim Ronda</h2>
		@TeamSection(v)
	</section>
	<section class="mt-6" aria-labelledby="situation-title">
		<h2 id="situation-title" class="mb-2 font-semibold">Situasi</h2>
		<textarea
			name="note"
			maxlength="1000"
			rows="4"
			class="textarea textarea-bordered w-full"
			placeholder="Mis. Aman"
			aria-describedby="situation-status"
			hx-post="/patrol/tonight/situation"
			hx-trigger="keyup changed delay:800ms, change"
			hx-target="#situation-status"
			hx-swap="innerHTML"
		>{ v.Situation }</textarea>
		<p id="situation-status" class="mt-1 text-xs text-base-content/60" aria-live="polite"></p>
	</section>
	<section class="mt-6" aria-labelledby="photo-title">
		<h2 id="photo-title" class="mb-2 font-semibold">Foto</h2>
		@PhotoPanel(v)
		<input id="photo-input" type="file" accept="image/*" capture="environment" hidden/>
		<button id="photo-button" type="button" class="btn btn-primary mt-3 w-full" onclick="document.getElementById('photo-input').click()">Ambil Foto</button>
	</section>
	<section class="mt-8" id="rain-box">
		@RainPanel(v)
	</section>
	<script src="/static/js/patrol.js" defer></script>
	<script src="/static/js/photo.js" defer></script>
}

// TeamSection is the team list plus the walk-in form; it is swapped as one unit.
templ TeamSection(v service.TonightView) {
	<div id="team-section" x-data="{ adding: false }">
		if len(v.Team) == 0 {
			@EmptyState("Belum ada tim untuk malam ini.")
		}
		<ul id="team-list" class="divide-y divide-base-300 rounded-box bg-base-100 shadow-sm">
			for _, r := range v.Team {
				if v.Locked {
					<li class="flex min-h-12 items-center justify-between px-3 py-2">
						<span>{ r.DisplayName }</span>
						<span class="text-sm text-base-content/70">
							if r.Present {
								Hadir
							} else {
								Tidak hadir
							}
						</span>
					</li>
				} else {
					@TeamRowItem(r)
				}
			}
		</ul>
		if len(v.Candidates) > 0 && !v.Locked {
			<button type="button" class="btn btn-ghost btn-sm mt-2" x-show="!adding" @click="adding = true">Tambah anggota pengganti</button>
			<form
				x-show="adding"
				x-cloak
				class="mt-2 flex gap-2"
				hx-post="/patrol/tonight/walk-in"
				hx-target="#team-section"
				hx-swap="outerHTML"
			>
				<select name="member_id" class="select select-bordered flex-1" aria-label="Anggota pengganti" required>
					<option value="">Pilih anggota</option>
					for _, c := range v.Candidates {
						<option value={ itoa(c.ID) }>{ c.Label }</option>
					}
				</select>
				<button type="submit" class="btn btn-primary">Tambah</button>
			</form>
		}
	</div>
}

// TeamRowItem is one tappable row; the whole row toggles the checkbox.
templ TeamRowItem(r service.TeamRow) {
	<li id={ "member-" + itoa(r.MemberID) }>
		<label class="flex min-h-12 cursor-pointer items-center justify-between gap-3 px-3 py-2">
			<span>
				{ r.DisplayName }
				if r.Source == domain.SourceWalkIn {
					<span class="badge badge-ghost badge-sm ml-1">pengganti</span>
				}
			</span>
			<input
				type="checkbox"
				class="checkbox checkbox-lg checkbox-primary"
				checked?={ r.Present }
				aria-label={ "Hadir: " + r.DisplayName }
				hx-post={ "/patrol/tonight/attendance/" + itoa(r.MemberID) }
				hx-trigger="change"
				hx-vals={ fmt.Sprintf(`{"present": %t}`, !r.Present) }
				hx-target="closest li"
				hx-swap="outerHTML"
			/>
		</label>
	</li>
}

templ SituationSaved(at string) {
	Tersimpan pukul { at }
}

templ PhotoPanel(v service.TonightView) {
	<div id="photo-list">
		<p id="photo-count" class={ "text-sm", templ.KV("text-warning", len(v.Photos) < v.MinPhotos) }>
			{ fmt.Sprint(len(v.Photos)) } dari minimal { fmt.Sprint(v.MinPhotos) } foto (maks. { fmt.Sprint(v.MaxPhotos) })
		</p>
		<ul class="mt-2 grid grid-cols-3 gap-2">
			for _, p := range v.Photos {
				<li>
					<img
						src={ "/patrol/tonight/photos/" + itoa(p.ID) + "/thumb" }
						alt={ "Foto ronda pukul " + ClockText(p.TakenAt) }
						class="aspect-square w-full rounded object-cover"
						loading="lazy"
					/>
				</li>
			}
		</ul>
	</div>
}

templ RainPanel(v service.TonightView) {
	if v.RainRequested {
		@FlashMessage("warning", "Hujan diajukan, menunggu konfirmasi pengurus.")
	} else {
		<button
			type="button"
			class="btn btn-outline btn-sm w-full"
			hx-post="/patrol/tonight/rain"
			hx-confirm="Ajukan malam ini sebagai hujan? Pengurus akan mengonfirmasi."
			hx-target="#rain-box"
			hx-swap="innerHTML"
		>Ajukan Hujan</button>
	}
}
