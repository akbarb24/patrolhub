package view

templ LoginPage(username, errMsg string) {
	@PublicLayout("Masuk Admin") {
		@pageTitle("Khusus pengurus", "Masuk Admin")
		if errMsg != "" {
			<div class="mb-5">
				@FlashMessage("error", errMsg)
			</div>
		}
		<form method="post" action="/admin/login" class="sticker p-7">
			<input type="hidden" name="csrf_token" value={ Page(ctx).CSRFToken }/>
			<label class="mb-2 block px-2 text-sm font-semibold" for="username">Username</label>
			<input id="username" name="username" type="text" value={ username } autocomplete="username" autocapitalize="none" required class="input mb-5 w-full"/>
			<label class="mb-2 block px-2 text-sm font-semibold" for="password">Password</label>
			<input id="password" name="password" type="password" autocomplete="current-password" required class="input mb-7 w-full"/>
			<button type="submit" class="btn btn-primary btn-lg w-full">Masuk</button>
		</form>
	}
}
