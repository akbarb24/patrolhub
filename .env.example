APP_ENV=development
HTTP_ADDR=:8080
BASE_URL=http://localhost:8080
DATABASE_URL=postgres://patrolhub:patrolhub@localhost:5432/patrolhub?sslmode=disable
PHOTO_DIR=./data/photos
TRUST_PROXY=false
# Optional defaults for the report window (HH:MM, Asia/Jakarta). Applied at startup
# only until go_live_date is set; afterwards edit them under Admin > Pengaturan.
WINDOW_OPEN=08:00
WINDOW_CLOSE=17:00
# Optional S3-compatible photo storage. When BUCKET_NAME is set, photos go to the
# bucket and PHOTO_DIR is ignored. On Fly, `fly storage create` sets these as secrets.
# For the dev SeaweedFS (docker compose --profile s3 up -d), create the bucket once:
#   docker compose exec seaweedfs sh -c 'echo "s3.bucket.create -name patrolhub-photos" | weed shell'
# BUCKET_NAME=patrolhub-photos
# AWS_ENDPOINT_URL_S3=http://localhost:8333
# AWS_ACCESS_KEY_ID=dev
# AWS_SECRET_ACCESS_KEY=dev-secret
# AWS_REGION=us-east-1
# S3_PATH_STYLE=true
